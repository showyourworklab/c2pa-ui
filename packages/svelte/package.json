{
	"name": "syw-svelte",
	"version": "0.0.9",
	"description": "",
	"author": "Show Your Work Lab",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev --config vite.demo.config.js",
		"build": "npm run build:lib && npm run build:demo",
		"build:lib": "npm run package && npm run copy:types && publint",
		"build:demo": "vite build --config vite.demo.config.js",
		"copy:types": "cp src/lib/index.d.ts dist/index.d.ts",
		"package": "svelte-package --preserve-output true",
		"preview": "vite preview",
		"publish": "npm publish --access=public",
		"lint": "eslint ."
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.21.2",
		"@videojs/html": "^10.0.0-beta.6",
		"maplibre-gl": "^5.18.0"
	},
	"devDependencies": {
		"@contentauth/c2pa-web": "^0.6.1",
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/adapter-static": "^3.0.1",
		"@sveltejs/kit": "^2.21.4",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "5.1.0",
		"@types/eslint": "^8.56.7",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^2.36.0",
		"publint": "^0.1.9",
		"sass": "^1.89.2",
		"svelte": "^5.34.1",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.4.1",
		"typescript": "^5.9.3",
		"vite": "^6.3.5",
		"vite-plugin-devtools-json": "^0.2.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
