{
	"name": "syw-svelte",
	"version": "0.0.8",
	"description": "",
	"author": "Show Your Work Lab",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"dev": "npm run copy:common && vite dev --config vite.demo.config.js",
		"build": "npm run build:lib && npm run build:demo",
		"build:lib": "npm run copy:common && vite build && npm run package && publint",
		"build:demo": "npm run copy:common && vite build --config vite.demo.config.js",
		"copy:common": "cp -R ../common ./src/lib",
		"package": "svelte-package --input src/lib",
		"preview": "vite preview",
		"publish": "npm publish",
		"lint": "eslint ."
	},
	"dependencies": {
		"syw-common": "^0.0.7",
		"syw-docs": "^0.0.7",
		"vite-plugin-css-injected-by-js": "^3.5.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.28.1",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/adapter-static": "^3.0.1",
		"@sveltejs/kit": "^2.21.4",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "5.1.0",
		"@types/eslint": "^8.56.7",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"publint": "^0.1.9",
		"sass": "^1.89.2",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^6.3.5",
		"vite-plugin-devtools-json": "^0.2.0"
	},
	"peerDependencies": {
		"c2pa": "^0.30.9",
		"svelte": "^5.34.1"
	}
}
