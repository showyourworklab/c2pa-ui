{
	"name": "syw-react",
	"version": "0.0.3",
	"description": "",
	"author": "Show Your Work Lab",
	"license": "ISC",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.es.js",
	"exports": {
		".": {
			"import": "./dist/index.es.js",
			"require": "./dist/index.umd.js"
		}
	},
	"files": [
		"dist/",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:lib && npm run build:demo",
		"build:lib": "vite build",
		"build:demo": "vite build --config vite.demo.config.js",
		"build:release": "rushx build",
		"serve": "vite preview --port 8080",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d ./public"
	},
	"dependencies": {
		"@contentauth/react": "0.2.87",
		"@contentauth/sdk": "^0.8.12",
		"c2pa": "^0.30.9",
		"c2pa-wc": "0.14.9",
		"react-collapsed": "^4.1.2",
		"syw-common": "^0.0.2"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^1.1.0",
		"gh-pages": "^6.1.1",
		"postcss": "~8.4.12",
		"postcss-nesting": "^10.0.2",
		"sass": "^1.89.2",
		"vite": "^6.3.5"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	}
}
