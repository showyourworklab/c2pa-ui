{
	"name": "syw-react",
	"version": "0.0.8",
	"description": "",
	"author": "Show Your Work Lab",
	"license": "MIT",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.es.js",
	"exports": {
		".": {
			"import": "./dist/index.es.js",
			"require": "./dist/index.umd.js"
		}
	},
	"files": [
		"dist/",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:lib && npm run build:demo",
		"build:lib": "vite build",
		"build:demo": "vite build --config vite.demo.config.js",
		"build:release": "rushx build",
		"serve": "vite preview --port 8080",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d ./public",
		"publish": "npm publish"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-visually-hidden": "^1.2.3",
		"react-collapsed": "^4.1.2",
		"syw-docs": "^0.0.7"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^1.1.0",
		"gh-pages": "^6.1.1",
		"postcss": "~8.4.12",
		"postcss-nesting": "^10.0.2",
		"sass": "^1.89.2",
		"vite": "^6.3.5"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"gitHead": "a0a7c93b5414c3e0a91e4d14b4a967daaa2fc938"
}
