{
	"name": "syw-react",
	"version": "0.0.16",
	"description": "",
	"author": "Show Your Work Lab",
	"license": "MIT",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.es.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.es.js",
			"require": "./dist/index.umd.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist/",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:lib && npm run build:demo",
		"build:lib": "vite build && npm run copy:types",
		"build:demo": "vite build --config vite.demo.config.js",
		"build:release": "rushx build",
		"copy:types": "cp src/index.d.ts dist/index.d.ts",
		"serve": "vite preview --port 8080",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d ./public"
	},
	"dependencies": {
		"@contentauth/c2pa-web": "^0.5.7",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-visually-hidden": "^1.2.3",
		"react-collapsed": "^4.1.2"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^1.1.0",
		"baseline-browser-mapping": "^2.9.19",
		"gh-pages": "^6.1.1",
		"postcss": "~8.4.12",
		"postcss-nesting": "^10.0.2",
		"sass": "^1.89.2",
		"vite": "^6.3.5"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	}
}
